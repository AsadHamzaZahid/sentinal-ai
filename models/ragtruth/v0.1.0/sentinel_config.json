    "effective_batch_size": 16,
    "weight_decay": 0.01,
    "warmup_ratio": 0.1,
    "fp16": true,
    "seed": 42,
    "best_epoch_metric": "pr_auc on validation"
  },
  "split": "official train/test; validation = 20% of train grouped by source_id (GroupShuffleSplit, seed 42)",
  "versions": {
